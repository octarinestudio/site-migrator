{
	"name": "octarine-studio/site-migrator",
	"version": "1.0.0",
	"description": "Pull-based WordPress site migration plugin",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-or-later",
	"authors": [
		{
			"name": "Octarine Studio",
			"homepage": "https://octarinestudio.uk"
		}
	],
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"brain/monkey": "^2.6",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/wordpress-stubs": "^6.7",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.10",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.1",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"phpcs": "phpcs",
		"phpcbf": "phpcbf",
		"lint": "bash bin/lint-php.sh",
		"phpstan": "phpstan analyse -c phpstan.neon.dist --memory-limit=1G",
		"test": "phpunit",
		"check": [
			"@lint",
			"@phpcs",
			"@phpstan",
			"@test"
		]
	}
}
